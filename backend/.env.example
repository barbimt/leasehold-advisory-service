DJANGO_SECRET_KEY=change-me-locally
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=leasehold
DATABASE_USER=leasehold
DATABASE_PASSWORD=leasehold
DATABASE_HOST=localhost
# Host port published by Compose. Default 5432. If that port is taken, set POSTGRES_PORT in a root .env and use the same value here.
DATABASE_PORT=5432
